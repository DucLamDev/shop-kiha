# Copy to .env; all application settings are loaded from this root file.
MONGODB_URI=mongodb://127.0.0.1:27018/kiha
API_PORT=4000
API_HOST=127.0.0.1
API_INTERNAL_URL=http://127.0.0.1:4000
# Optional absolute path on a persistent disk; default .local/uploads/videos.
VIDEO_UPLOAD_DIR=
SITE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NODE_ENV=development
# Demo catalog is excluded by the public API in production.
SEED_DEMO=true
# Used only by npm run admin:create. Never use example credentials in production.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Initial settings; subsequent edits live in MongoDB via /admin/cai-dat.
SHOP_NAME=Nội Thất KIHA
SHOP_PHONE=
SHOP_ZALO_URL=
SHOP_FACEBOOK_URL=
SHOP_TIKTOK_URL=
SHOP_MAPS_URL=
SHOP_ADDRESS=
